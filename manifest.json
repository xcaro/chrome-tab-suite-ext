{
  "manifest_version": 3,
  "name": "Tab Suite",
  "version": "3.0.0",
  "description": "Browser tab toolkit: Save bookmarks · Close duplicates",
  "permissions": [
    "tabs",
    "bookmarks",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Suite"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
