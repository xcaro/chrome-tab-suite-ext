{
  "manifest_version": 3,
  "name": "Tab Suite",
  "version": "3.0.0",
  "description": "Browser tab toolkit: Save bookmarks · Close duplicates",
  "minimum_chrome_version": "114",

  "permissions": [
    "tabs",
    "bookmarks",
    "storage",
    "sidePanel"
  ],

  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },

  "action": {
    "default_title": "Tab Suite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "panel.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}